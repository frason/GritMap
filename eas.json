{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "development-simulator": {
      "extends": "development",
      "ios": {
        "simulator": true
      }
    },
    "preview": {
      "distribution": "internal"
    },
    "production": {
      "autoIncrement": true
    },
    "production-ble-internal": {
      "extends": "production",
      "env": {
        "EXPO_PUBLIC_GRITMAP_BLE_TRANSFER": "1"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6820850686"
      }
    },
    "production-ble-internal": {
      "extends": "production"
    }
  }
}
