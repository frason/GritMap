<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121417"
    android:orientation="vertical"
    android:padding="8dp">

    <TextView
        android:id="@+id/karoo_performance_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/karoo_performance_plan"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#FFC857"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/karoo_performance_finish"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/karoo_performance_adherence"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#20AA5B"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/karoo_performance_progress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#D0D4DA"
        android:textSize="12sp" />
</LinearLayout>
