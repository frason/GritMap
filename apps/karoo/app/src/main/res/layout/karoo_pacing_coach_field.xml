<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121417"
    android:orientation="vertical"
    android:padding="8dp">

    <TextView
        android:id="@+id/karoo_coach_action"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/karoo_coach_target"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#20AA5B"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/karoo_coach_actual"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="#D0D4DA"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/karoo_coach_next"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="#FFC857"
        android:textSize="12sp" />
</LinearLayout>
