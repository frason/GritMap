<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gm_field_background"
    android:orientation="vertical"
    android:padding="8dp">

    <TextView
        android:id="@+id/karoo_coach_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:paddingBottom="5dp"
        android:textColor="@color/gm_field_secondary_text"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/karoo_coach_action"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:minHeight="42dp"
        android:paddingTop="5dp"
        android:paddingBottom="5dp"
        android:textColor="@color/gm_field_primary_text"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/karoo_coach_target"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textColor="#20AA5B"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/karoo_coach_actual"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:textColor="@color/gm_field_secondary_text"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/karoo_coach_next"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:textColor="#FFC857"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/karoo_coach_quality"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:paddingTop="6dp"
        android:textColor="@color/gm_field_secondary_text"
        android:textSize="13sp"
        android:textStyle="bold" />
</LinearLayout>
